---
import ruleta_art from "@/assets/images/ruleta/ruleta-wheel.webp";
import glow_disc from "@/assets/images/ruleta/glow-disc.svg";
import glow_ring from "@/assets/images/ruleta/glow-ring.svg";
import glow_ellipse from "@/assets/images/ruleta/glow-ellipse.svg";
import prize_gift from "@/assets/images/ruleta/prize-gift.webp";
import prize_vales from "@/assets/images/ruleta/prize-vales.webp";
import prize_combo1 from "@/assets/images/ruleta/prize-combo1.webp";
import prize_combo2 from "@/assets/images/ruleta/prize-combo2.webp";
import prize_equipos from "@/assets/images/ruleta/prize-equipos.webp";
import bg_mobile from "@/assets/images/banner_mobile.webp";
import bg_tablet from "@/assets/images/banner_tablet.webp";
import bg_desktop from "@/assets/images/banner_desktop.webp";

// DOM order = slot index, clockwise from the pointer (every slot is 60deg).
// `slot` is the stable key used by the hydration script; `nombre` is only the
// initial value of data-nombre (the API name overwrites it later).
const slots = [
  { slot: "bonos", nombre: "Bonos", label: "Bonos", img: prize_gift },
  { slot: "vales", nombre: "Vales general", label: "Vales", img: prize_vales },
  {
    slot: "combo2",
    nombre: "Artefactos",
    label: "Combo 2",
    img: prize_combo2,
    stock: "0",
  },
  { slot: "bonos", nombre: "Bonos", label: "Bonos", img: prize_gift },
  { slot: "equipos", nombre: "Equipos", label: "Equipos y accesorios", img: prize_equipos },
  { slot: "combo1", nombre: "Accesorios", label: "Combo 1", img: prize_combo1 },
];
---

<section class="ruletaGanadora relative hidden" data-step="4">
  <picture class="w-full h-full absolute top-0 left-0 z-0">
    <source srcset={bg_desktop.src} media="(min-width: 1280px)" />
    <source srcset={bg_tablet.src} media="(min-width: 768px)" />
    <img
      class="w-full h-full object-cover"
      src={bg_mobile.src}
      alt="¡Gira la ruleta y gana premios al instante!"
    />
  </picture>
  <div class="container relative z-1">
    <p data-aos="zoom-in-up">
      ¡Felicitaciones! Tienes <b class="text_allow_user">1 oportunidad</b> para girar
      la ruleta
    </p>
    <h2 data-aos="zoom-in-up">¡Es hora de girar y ganar!</h2>
    <h4 data-aos="zoom-in-up">
      Haz clic en el botón de abajo y deja que la suerte decida tu premio.
    </h4>
    <button
      data-aos="zoom-in-up"
      class="cursor-pointer disabled:bg-gray-200 disabled:border-gray-200 disabled:text-gray-400 disabled:cursor-not-allowed transition-all duration-300 z-50"
      id="btnGirar">Gira la ruleta</button
    >
    <div
      class="contentRuleta opacity-0 transition-opacity duration-300"
      data-aos="zoom-in-down"
      data-aos-delay="100"
    >
      <div class="ruleta-stage">
        <img src={glow_ellipse.src} alt="" aria-hidden="true" class="ruleta-glow ruleta-glow--ellipse" />
        <img src={glow_disc.src} alt="" aria-hidden="true" class="ruleta-glow ruleta-glow--disc" />
        <img src={glow_ring.src} alt="" aria-hidden="true" class="ruleta-glow ruleta-glow--ring" />
        <div class="ruleta transition-opacity duration-300">
          <img src={ruleta_art.src} alt="" class="ruleta-art ruleta-art--disc" />
          {
            slots.map((s, i) => (
              <div
                class="item"
                data-slot={s.slot}
                data-nombre={s.nombre}
                data-stock={s.stock}
                style={`--i:${i}`}
              >
                <img
                  class="item__img"
                  src={s.img.src}
                  alt=""
                  data-prize-img
                  data-fallback={s.img.src}
                />
                <span class="item__label" data-prize-label data-default-label={s.label}>
                  {s.label}
                </span>
              </div>
            ))
          }
        </div>
        <img src={ruleta_art.src} alt="" class="ruleta-art ruleta-art--rim" />
        <img src={ruleta_art.src} alt="" class="ruleta-art ruleta-art--glow" />
        <img src={ruleta_art.src} alt="" class="ruleta-art ruleta-art--pointer" />
        <img src={ruleta_art.src} alt="" class="ruleta-art ruleta-art--hub" />
        <div class="isotipo_claro">
          <svg
            class="w-full h-full relative bg-logo-claro-gradient rounded-full"
            width="48"
            height="48"
            viewBox="0 0 48 48"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M27.4407 22.1073L42.8203 7.00478L38.7367 3.04688L23.3572 18.1494L27.4407 22.1073Z"
              fill="white"></path>
            <path d="M17.1317 0H11.6813V16.0108H17.1317V0Z" fill="white"></path>
            <path d="M47.4938 28.207H30.3663V33.544H47.4938V28.207Z" fill="white"
            ></path>
            <path
              d="M18.1749 39.1204C16.854 40.5036 15.1633 41.1184 13.2085 41.1184C11.3065 41.1184 9.6686 40.4524 8.34776 39.1204C7.02691 37.7372 6.28724 36.1491 6.28724 34.3048C6.28724 32.3581 7.02691 30.77 8.34776 29.438C9.6686 28.0548 11.3593 27.4401 13.2085 27.4913C15.1633 27.4401 16.8012 28.1061 18.2277 29.438C19.4957 30.7188 20.1826 32.3581 20.2354 34.3048C20.1826 36.1491 19.4957 37.7372 18.1749 39.1204ZM22.6129 25.1347C19.9712 22.5733 16.8012 21.3438 13.2085 21.3438C9.61577 21.3438 6.49857 22.5733 3.90971 25.1347C1.26802 27.6962 0 30.77 0 34.3048C0 37.8397 1.26802 40.9647 3.90971 43.4237C6.44574 45.9852 9.56294 47.2659 13.2085 47.2659C16.8012 47.2659 19.9712 45.9852 22.6129 43.4237C25.2018 40.9135 26.4698 37.8397 26.4698 34.3048C26.4698 30.77 25.2018 27.6962 22.6129 25.1347Z"
              fill="white"></path>
          </svg>
        </div>
      </div>
    </div>
    <p class="legal">
      *Imágenes referenciales. Aplican cambios según disponibilidad de stock.
    </p>
  </div>
</section>

<style>
  section.ruletaGanadora {
    overflow-x: clip;
    background-color: #000;
    p {
      color: #fff;
      text-align: center;
      font-family: "AMX Regular";
      font-size: 30px;
      font-style: normal;
      font-weight: 400;
      line-height: 100%;
      letter-spacing: 0.6px;

      b {
        font-family: AMX;
        font-weight: 700;
      }
    }

    h2 {
      color: #fff;
      font-family: AMX;
      font-size: 50px;
      font-style: normal;
      font-weight: 800;
      line-height: normal;
      text-align: center;
      margin-top: 7px;
    }

    h4 {
      display: block;
      color: #fff;
      text-align: center;
      font-family: AMX;
      font-size: 20px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
      margin-top: 10px;
    }

    button {
      color: #fff;
      text-align: center;
      font-family: AMX;
      font-size: 20px;
      font-style: normal;
      font-weight: 700;
      line-height: normal;
      border-radius: 110px;
      background: #da291c;
      width: 204px;
      height: 55px;
      border: none;
      margin: 0 auto;
      display: block;
      margin-top: 18px;

      &.disabled {
        opacity: 0.4;
        pointer-events: none;
      }
    }

    .contentRuleta {
      position: relative;
      margin-bottom: 50px;
      /* --W is the width of the wheel art; every measure below is N * --u (1% of --W). */
      --W: min(670px, calc(100vw - 24px));
      --u: calc(var(--W) / 100);
    }

    .ruleta-stage {
      position: relative;
      width: var(--W);
      aspect-ratio: 1340 / 1362;
      margin: 50px auto 0;
      /* Geometry of the art (calibrated against ruleta-wheel.webp). */
      --cx: calc(var(--u) * 50.3);
      --cy: calc(var(--u) * 51.12);
      --disc-r: calc(var(--u) * 39.7);
      --hub-r: calc(var(--u) * 14.6);
      --disc-edge: calc(var(--u) * 0.35);
    }

    /* Glows: static decoration behind the wheel (positions from the Figma frame). */
    .ruleta-glow {
      position: absolute;
      max-width: none;
      height: auto;
      pointer-events: none;
      user-select: none;
    }
    .ruleta-glow--ellipse {
      left: calc(var(--u) * -97.8);
      top: calc(var(--u) * -30.1);
      width: calc(var(--u) * 209.4);
    }
    .ruleta-glow--disc {
      left: calc(var(--u) * -17.25);
      top: calc(var(--u) * -12.36);
      width: calc(var(--u) * 129.1);
    }
    .ruleta-glow--ring {
      left: calc(var(--u) * -4.8);
      top: calc(var(--u) * -4.24);
      width: calc(var(--u) * 109.7);
    }

    /* The only element animated by gsap: a circle clipped to the slices. */
    .ruleta {
      position: absolute;
      z-index: 1;
      left: calc(var(--cx) - var(--disc-r));
      top: calc(var(--cy) - var(--disc-r));
      width: calc(var(--disc-r) * 2);
      height: calc(var(--disc-r) * 2);
      border-radius: 50%;
      overflow: hidden;
      will-change: transform;
    }

    .ruleta-art {
      position: absolute;
      max-width: none;
      height: auto;
      pointer-events: none;
      user-select: none;
    }
    .ruleta-art--disc {
      width: var(--W);
      left: calc(var(--disc-r) - var(--cx));
      top: calc(var(--disc-r) - var(--cy));
    }
    /* Fixed layers cut out of the same art: rim, pointer and hub. */
    .ruleta-art--rim,
    .ruleta-art--glow,
    .ruleta-art--pointer,
    .ruleta-art--hub {
      left: 0;
      top: 0;
      width: 100%;
      z-index: 2;
    }
    .ruleta-art--rim,
    .ruleta-art--glow {
      -webkit-mask-image: radial-gradient(
        circle at var(--cx) var(--cy),
        transparent var(--disc-r),
        #000 calc(var(--disc-r) + var(--disc-edge))
      );
      mask-image: radial-gradient(
        circle at var(--cx) var(--cy),
        transparent var(--disc-r),
        #000 calc(var(--disc-r) + var(--disc-edge))
      );
    }
    .ruleta-art--glow {
      filter: blur(6.834px);
      mix-blend-mode: overlay;
    }
    .ruleta-art--pointer {
      z-index: 3;
      clip-path: polygon(40% 8%, 60% 8%, 60% 17%, 40% 17%);
    }
    .ruleta-art--hub {
      z-index: 3;
      clip-path: circle(var(--hub-r) at var(--cx) var(--cy));
    }

    .isotipo_claro {
      position: absolute;
      z-index: 20;
      left: var(--cx);
      top: var(--cy);
      width: calc(var(--u) * 12.5);
      height: calc(var(--u) * 12.5);
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    /* Prize slots: a 0x0 box at the wheel centre rotated 60deg * index; children
       are pushed outwards along the slot axis (so no per-breakpoint offsets). */
    .ruleta .item {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 0;
      height: 0;
      transform: rotate(calc(var(--i) * 60deg));

      --r: 28;
      --tx: 0;
      --tilt: 0deg;
      --pw: 16;
      --ph: 16;
      --lr: 17.5;
      --ltx: 0;
      --ltilt: 0deg;
      --lf: 1.92;

      .item__img,
      .item__label {
        position: absolute;
        left: 0;
        top: 0;
        transform-origin: 0 0;
      }

      .item__img {
        width: calc(var(--u) * var(--pw));
        height: calc(var(--u) * var(--ph));
        object-fit: contain;
        max-width: none;
        transform: translate(
            calc(var(--u) * var(--tx)),
            calc(var(--u) * var(--r) * -1)
          )
          rotate(var(--tilt)) translate(-50%, -50%);
      }

      .item__label {
        width: max-content;
        max-width: calc(var(--u) * 10.5);
        text-align: center;
        text-transform: uppercase;
        text-wrap: balance;
        font-family: "AMX Black", sans-serif;
        font-weight: 400;
        font-size: max(calc(var(--u) * var(--lf)), 7.5px);
        line-height: 1.09;
        color: #83170f;
        pointer-events: none;
        transform: translate(
            calc(var(--u) * var(--ltx)),
            calc(var(--u) * var(--lr) * -1)
          )
          rotate(var(--ltilt)) translate(-50%, -50%);
      }

      &[data-slot="bonos"] {
        --r: 20.63;
        --tx: 0.23;
        --pw: 8.5;
        --ph: 8.5;
        --lr: 31;
        --lf: 3.49;
        .item__label {
          max-width: calc(var(--u) * 16);
        }
      }
      &[data-slot="vales"] {
        --r: 28.31;
        --tx: 1.59;
        --tilt: -24.55deg;
        --pw: 20.78;
        --ph: 14.16;
        --lr: 17.14;
        --ltx: 0.88;
      }
      &[data-slot="combo2"] {
        --r: 28.65;
        --tx: 0.07;
        --tilt: 22.39deg;
        --pw: 17.4;
        --ph: 16.85;
        --lr: 16.9;
        --ltx: -0.4;
      }
      &[data-slot="equipos"] {
        --r: 27.62;
        --tx: 1.66;
        --pw: 16.63;
        --ph: 19.16;
        --lr: 20.28;
        --ltx: 0.26;
        --ltilt: 5.78deg;
        .item__label {
          max-width: calc(var(--u) * 11.5);
        }
      }
      &[data-slot="combo1"] {
        --r: 28.05;
        --tx: -0.84;
        --tilt: -1.34deg;
        --pw: 14.87;
        --ph: 18.36;
        --lr: 17.78;
        --ltx: -0.2;
      }
    }
    .legal {
      color: #fff;
      text-align: center;
      font-family: Roboto;
      font-size: 14px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
    }
  }

  .modalPremio {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 99999;

    &.active {
      display: flex;
    }

    .modalContent {
      background: #fff;
      padding: 30px;
      border-radius: 10px;
      width: 80%;
      max-width: 350px;
      text-align: center;
    }
  }

  @media (max-width: 1280px) {
    section.ruletaGanadora p {
      font-size: 28px;
    }

    section.ruletaGanadora h2 {
      font-size: 46px;
    }

    section.ruletaGanadora span {
      font-size: 18px;
    }
  }

  @media (max-width: 900px) {
    section.ruletaGanadora p {
      font-size: 25px;
    }

    section.ruletaGanadora h2 {
      font-size: 42px;
    }

    section.ruletaGanadora span {
      font-size: 18px;
    }
  }

  @media (max-width: 750px) {
    section.ruletaGanadora p {
      font-size: 20px;
    }

    section.ruletaGanadora h2 {
      font-size: 35px;
    }

    section.ruletaGanadora span {
      font-size: 16px;
    }

    section.ruletaGanadora button {
      font-size: 18px;
      width: 183px;
      height: 48px;
    }
  }


  @media (max-width: 660px) {
    section.ruletaGanadora .ruleta-stage {
      margin-top: 30px;
    }
  }

  @media (max-width: 500px) {
    section.ruletaGanadora .ruleta-stage {
      margin-top: 20px;
    }

    section.ruletaGanadora .contentRuleta {
      margin-bottom: 20px;
    }

    section.ruletaGanadora p {
      font-size: 16px;
    }

    section.ruletaGanadora h2 {
      font-size: 30px;
    }

    section.ruletaGanadora span {
      font-size: 14px;
    }

    section.ruletaGanadora button {
      font-size: 16px;
      width: 160px;
      height: 41px;
    }

    section.ruletaGanadora .legal {
      font-size: 12px;
    }
  }
</style>

<script>
  import AOS from "aos";
  import { gsap } from "gsap";
  import JustValidate from "just-validate";
  import { togglePreloadAnimation } from "@/utils/animations";
  import {
    getListProducts,
    validUserEnabled,
    spinSaveResult,
    resolveAssetUrl,
  } from "@/utils/endpoints";
  import { userStore } from "@/store/userStore";
  import { showCustomModal } from "@/utils/modalHelper";
  import icon_no_cumple from "@/assets/icons/icon_no_cumple.svg";

  const btnGirar = document.querySelector("#btnGirar") as HTMLButtonElement;
  const ruletaTable = document.querySelector(".ruleta") as HTMLElement;
  const containerRuleta = document.querySelector(
    ".contentRuleta",
  ) as HTMLElement;
  const items = document.querySelectorAll(".ruleta .item");

  // Seams for the local dev harness (src/utils/ruletaDev.js). In production they
  // are just the real endpoints, a random pick among the available slots and 10s.
  const deps = {
    validUserEnabled,
    getListProducts,
    spinSaveResult,
    pickIndex: (available: { index: number }[]) =>
      available[Math.floor(Math.random() * available.length)].index,
    spinDuration: 10,
  };

  // Slot i is centred at 60 * i degrees clockwise from the pointer, so the pointer
  // lands on slot i when the wheel rotation is congruent to -60 * i (mod 360).
  const SLOT0_CENTER_DEG = 0;
  const targetAngle = (index: number, total: number) =>
    (360 - (360 / total) * index - SLOT0_CENTER_DEG + 360) % 360;

  let yaGiro = false;
  let gradosActuales = 0;
  let ruletaIntroTween: gsap.core.Tween | null = null;

  const resetAosAnimations = (element: Element) => {
    const aosElements = element.querySelectorAll("[data-aos]");
    aosElements.forEach((el) => {
      el.classList.remove("aos-animate", "aos-init");
    });
  };

  const resetRuleta = () => {
    const sectionRuleta = document.querySelector(
      ".ruletaGanadora",
    ) as HTMLElement;
    if (!sectionRuleta) return;
    document
      .querySelectorAll(".section_hidden")
      .forEach((section) => section.classList.remove("hidden"));
    sectionRuleta.classList.add("hidden");
    document.querySelector(".main_ruleta").classList.add("overflow-hidden");
    document.querySelector("[data-step='3']").classList.add("hidden");
    document.querySelector("[data-step='2']").classList.remove("hidden");
    document
      .querySelector("[data-step='2']")
      .classList.remove("hidden", "xl:hidden");
    ruletaTable.removeAttribute("style");
    setTimeout(() => AOS.refreshHard(), 50);
    sectionRuleta
      .querySelector("svg")
      .classList.add("bg-logo-claro-gradient", "rounded-full");
    sectionRuleta.querySelector("svg").removeAttribute("style");
    containerRuleta.classList.add("opacity-0");
    // Reiniciar estado interno de la ruleta para que el siguiente giro parta desde 0°
    gradosActuales = 0;
    yaGiro = false;
    resetForm();
    //reemover el localStorage
    localStorage.removeItem("user");
    userStore.setState({ user: null });
  };

  const showRuleta = () => {
    document
      .querySelectorAll(".section_hidden")
      .forEach((section) => section.classList.add("hidden"));
    document.querySelector(".ruletaGanadora").classList.remove("hidden");
  };

  const showModalWin = (dataResponse, user) => {
    window.dispatchEvent(
      new CustomEvent("premio:show", {
        detail: {
          prizeName: dataResponse?.prizeName,
          prizeImageUrl: dataResponse?.prizeImageUrl,
        },
      }),
    );
  };

  // The prize modal (Modal/Premio.astro) emits this once per close,
  // whatever the path (button, X, ESC, backdrop).
  window.addEventListener("premio:close", () => {
    resetRuleta();
  });

  const hasStockAvailable = (value) => {
    if (typeof value === "boolean") return value;
    if (typeof value === "number") return value > 0;
    if (typeof value === "string") {
      const normalized = value.trim().toLowerCase();
      return ["true", "1", "si", "sí", "yes"].includes(normalized);
    }
    return false;
  };

  async function girarRuleta() {
    const { user } = userStore.getState();
    const { fullClaro, product, detallePlay } = user;
    if (yaGiro) return;
    yaGiro = true;

    btnGirar.disabled = true;

    if (ruletaIntroTween) {
      ruletaIntroTween.kill();
      ruletaIntroTween = null;
    }
    gsap.killTweensOf(ruletaTable, "rotation");
    const isUserFijaFullClaro100Mbps =
      fullClaro === false && product === "Fija" && detallePlay === "1000";
    const categoryIdExclude = isUserFijaFullClaro100Mbps ? 10 : null; //No debe caer en bonos

    try {
      const latestProductsResponse = await deps.getListProducts(
        user.provinceId,
        user.serviceId,
      );
      const latestProducts = latestProductsResponse?.data || [];
      const latestStockByPrizeType = new Map(
        latestProducts.map((product) => [
          Number(product.prizeTypeId),
          hasStockAvailable(product.hasStock),
        ]),
      );
      const combosProduct = latestProducts.find(
        (product) => product.prizeTypeName === "Combos",
      );
      const comboSubtypeStock = new Map(
        (combosProduct?.subtypes || []).map((subtype) => [
          Number(subtype.id),
          hasStockAvailable(subtype.hasStock),
        ]),
      );

      items.forEach((item) => {
        const categoryId = Number(item.getAttribute("data-category_id"));
        if (!Number.isFinite(categoryId)) {
          item.setAttribute("data-stock", "0");
          return;
        }
        const hasStock = latestStockByPrizeType.has(categoryId)
          ? latestStockByPrizeType.get(categoryId)
          : comboSubtypeStock.get(categoryId);
        if (hasStock === undefined) {
          item.setAttribute("data-stock", "0");
          return;
        }
        item.setAttribute("data-stock", hasStock ? "1" : "0");
      });
    } catch (error) {
      console.error("Error al revalidar stock antes del giro:", error);
      showCustomModal({
        title: "No se pudo validar stock",
        html: `<p>Inténtalo nuevamente en unos segundos.</p>`,
        iconSrc: icon_no_cumple.src,
        confirmButtonText: "Entendido",
        showCloseButton: false,
      });
      yaGiro = false;
      btnGirar.disabled = false;
      return;
    }

    // Filtrar solo los ítems con stock > 0
    const itemsDisponibles: { index: number; element: Element }[] = [];
    items.forEach((item, index) => {
      const stockAttr = item.getAttribute("data-stock");
      const stock = stockAttr ? Number(stockAttr) : 0;
      const categoryId = Number(item.getAttribute("data-category_id"));
      // Regla especial: si el usuario es Fija Full Claro 100Mbps,
      // se excluye una categoría específica para que no sea elegible al giro.
      // categoryIdExclude será null si la regla no aplica.
      const isExcludedCategory =
        Number.isFinite(categoryId) && categoryIdExclude === categoryId;
      if (stock > 0 && !isExcludedCategory) {
        itemsDisponibles.push({ index, element: item });
      }
    });
    // Si no hay ítems disponibles, cancelamos el giro y reactivamos el botón
    if (itemsDisponibles.length === 0) {
      console.warn(
        "No hay ítems disponibles con stock > 0 para girar la ruleta.",
      );
      showCustomModal({
        title: "Lo sentimos, no puedes participar en estos momentos 👇",
        html: `<p>No hay premios disponibles para girar la ruleta.</p>`,
        iconSrc: icon_no_cumple.src,
        confirmButtonText: "Volver al inicio",
        showCloseButton: false,
        onConfirm: () => {
          resetRuleta();
        },
      });
      yaGiro = false;
      btnGirar.disabled = true;
      return;
    }

    const vueltasExtras = 360 * 10;

    // Elegimos aleatoriamente uno de los items disponibles (con stock > 0)
    const indiceGanador = deps.pickIndex(itemsDisponibles);

    // El ángulo se normaliza para que un segundo giro (sin reset) también caiga
    // exactamente bajo la flecha del slot ganador.
    const base = gradosActuales - (((gradosActuales % 360) + 360) % 360);
    const anguloFinal =
      base + vueltasExtras + targetAngle(indiceGanador, items.length);

    gsap.to(ruletaTable, {
      rotation: anguloFinal,
      duration: deps.spinDuration,
      ease: "power3.out",
      onComplete: async () => {
        const itemGanador = items[indiceGanador];
        const category_id = itemGanador.getAttribute("data-category_id");
        const category_name = itemGanador.getAttribute("data-nombre");
        //console.log(`Categoría Ganador: ${category_name}, con ID ${category_id}`);
        if (!category_id || Number.isNaN(Number(category_id))) {
          showCustomModal({
            title: "No se pudo registrar el giro",
            html: `<p>No se encontró una categoría válida para este premio.</p>`,
            iconSrc: icon_no_cumple.src,
            confirmButtonText: "Volver al inicio",
            showCloseButton: false,
            onConfirm: () => {
              resetRuleta();
            },
          });
          return;
        }
        // Después del giro mostrar modal
        btnGirar.disabled = false;
        try {
          //console.log("Giro completado");
          const spinSaveResultResponse = await deps.spinSaveResult(
            user.serviceId,
            Number(category_id),
          );
          //console.log({ spinSaveResultResponse });
          if (spinSaveResultResponse?.result === "WIN") {
            showModalWin(spinSaveResultResponse, user);
          } else if (spinSaveResultResponse?.result === "NO_STOCK") {
            showCustomModal({
              title: "Lo sentimos, no hay stock disponible",
              html: `<p>${spinSaveResultResponse?.message || "No hay premios disponibles para esta categoría en este momento."}</p>`,
              iconSrc: icon_no_cumple.src,
              confirmButtonText: "Volver al inicio",
              showCloseButton: false,
              onConfirm: () => {
                resetRuleta();
              },
            });
          } else {
            showCustomModal({
              title: "Resultado de tu jugada",
              html: `<p>${spinSaveResultResponse?.message || "No fue posible registrar el resultado del giro."}</p>`,
              iconSrc: icon_no_cumple.src,
              confirmButtonText: "Volver al inicio",
              showCloseButton: false,
              onConfirm: () => {
                resetRuleta();
              },
            });
          }
        } catch (error) {
          console.error("Error en spinSaveResult:", error);
          const resultCode = String(error?.result || "").toUpperCase();
          const errorMessage =
            error?.apiMessage || error?.message || "Error al procesar el giro.";

          if (
            resultCode === "NO_STOCK" ||
            String(errorMessage).toLowerCase().includes("stock")
          ) {
            showCustomModal({
              title: "Lo sentimos, no hay stock disponible",
              html: `<p>No hay premios disponibles para esta categoría en este momento.</p>`,
              iconSrc: icon_no_cumple.src,
              confirmButtonText: "Volver al inicio",
              showCloseButton: false,
              onConfirm: () => {
                resetRuleta();
              },
            });
          } else {
            showCustomModal({
              title: "Ocurrió un problema al registrar tu jugada",
              html: `<p>Por favor, intenta nuevamente.</p>`,
              iconSrc: icon_no_cumple.src,
              confirmButtonText: "Entendido",
              showCloseButton: false,
            });
          }
        } finally {
          togglePreloadAnimation(false);
        }
      },
    });

    gradosActuales = anguloFinal;
  }

  const eventInitRuleta = new CustomEvent("ruleta:enter");
  const resetForm = () => {
    const form = document.querySelector("#form-registro") as HTMLFormElement;
    const submitBtn = document.querySelector(
      "#btn-submit-form",
    ) as HTMLButtonElement;
    const fieldName = document.querySelector("#name") as HTMLInputElement;
    const fieldEmail = document.querySelector("#email") as HTMLInputElement;
    const fieldDni = document.querySelector("#dni") as HTMLInputElement;
    const fieldPhone = document.querySelector("#phone") as HTMLSelectElement;
    const selectDeparment = document.querySelector(
      "#departament",
    ) as HTMLSelectElement;
    const selectProvince = document.querySelector(
      "#province",
    ) as HTMLSelectElement;
    form.reset();
    // Limpiar clases de validación para que el formulario se vea "prístino"
    const campos = form.querySelectorAll("input, select, textarea");
    campos.forEach((campo: HTMLElement) => {
      campo.classList.remove(
        "border-green-500",
        "border-red-500",
        "just-validate-success-field",
        "just-validate-error-field",
      );
    });
    // Eliminar labels de error generados por JustValidate (si quedara alguno)
    form
      .querySelectorAll(".just-validate-error-label")
      .forEach((label) => label.remove());
    fieldPhone.disabled = true;
    fieldName.disabled = true;
    fieldEmail.disabled = true;
    fieldDni.disabled = true;
    submitBtn.disabled = true;
    selectDeparment.disabled = true;
    selectProvince.disabled = true;
  };

  document.addEventListener("ruleta:enter", async () => {
    const { user } = userStore.getState();
    console.log({ user });
    try {
      const userEnabledResponse = await deps.validUserEnabled(
        user.serviceId,
        user.id,
      );
      const { canSpin, remainingPlays, playsAllowed, playsUsed, reason } =
        userEnabledResponse || {};
      const mainRuleta = document.querySelector(".main_ruleta");
      showRuleta();
      if (window.innerWidth >= 1200) {
        mainRuleta.classList.remove("overflow-hidden");
      } else {
        // mainRuleta.classList.add("h-full");
      }
      //Botón para animacion de entrada de ruleta
      const isotipoWrapper = document.querySelector(".isotipo_claro");
      const isotipo = isotipoWrapper?.querySelector("svg");
      // Animar el isotipo cuando se hace clic en el botón de entrada
      const forseCanSpin = true;
      if (canSpin) {
        const listProductsResponse = await deps.getListProducts(
          user.provinceId,
          user.serviceId,
        );
        const dataProducts = listProductsResponse?.data || [];
        // const dataProducts = fakeProducts?.data || [];
        console.log({ dataProducts });
        const totalStockProducts = dataProducts.filter((product) =>
          hasStockAvailable(product.hasStock),
        ).length;
        //console.log({listProductsResponse, totalStockProducts})
        if (dataProducts.length === 0) {
          showCustomModal({
            title: "Lo sentimos, no puedes participar en estos momentos 👇",
            html: `<p>No hay premios disponibles para girar la ruleta.</p>`,
            iconSrc: icon_no_cumple.src,
            confirmButtonText: "Volver al inicio",
            showCloseButton: false,
            onConfirm: () => {
              resetRuleta();
            },
          });
          return;
        }
        if (totalStockProducts === 0) {
          showCustomModal({
            title: "Lo sentimos, no puedes participar en estos momentos 👇",
            html: `<p>No hay premios disponibles para girar la ruleta.</p>`,
            iconSrc: icon_no_cumple.src,
            confirmButtonText: "Volver al inicio",
            showCloseButton: false,
            onConfirm: () => {
              resetRuleta();
            },
          });
          return;
        }
        const findType = (name: string) =>
          dataProducts.find((product) => product.prizeTypeName === name);
        const bonosResponse = findType("Bonos");
        const equiposYAccesoriosResponse = findType("Equipos y accesorios");
        const valesResponse = findType("Vales");
        const combosResponse = findType("Combos");
        const subtypes = combosResponse?.subtypes ?? [];
        const comboRef = combosResponse?.imageUrl;

        // Normalized entry for a slot: id, label/name, stock flag and image URL.
        const typeEntry = (response, refUrl = response?.imageUrl) =>
          response && {
            id: response.prizeTypeId,
            name: response.prizeTypeName,
            hasStock: response.hasStock,
            image: resolveAssetUrl(response.imageUrl, refUrl),
          };
        const comboEntry = (name: string) => {
          const combo = subtypes.find((subtype) => subtype.name === name);
          return (
            combo && {
              id: combo.id,
              name: combo.name,
              hasStock: combo.hasStock,
              image: resolveAssetUrl(combo.imagen, comboRef),
            }
          );
        };
        const entryBySlot = {
          bonos: typeEntry(bonosResponse),
          equipos: typeEntry(equiposYAccesoriosResponse),
          vales: typeEntry(valesResponse),
          combo2: comboEntry("Combo 2"),
          combo1: comboEntry("Combo 1"),
        };

        const hydrateSlot = (item: Element, entry) => {
          const img = item.querySelector("[data-prize-img]") as HTMLImageElement;
          const label = item.querySelector("[data-prize-label]") as HTMLElement;
          // Always restore the static defaults first so a re-enter never keeps
          // stale data from a previous hydration.
          img.onerror = () => {
            img.onerror = null;
            img.src = img.dataset.fallback;
          };
          if (!entry) {
            item.setAttribute("data-stock", "0");
            item.removeAttribute("data-category_id");
            img.src = img.dataset.fallback;
            label.textContent = label.dataset.defaultLabel;
            return;
          }
          item.setAttribute("data-nombre", entry.name);
          item.setAttribute(
            "data-stock",
            hasStockAvailable(entry.hasStock) ? "1" : "0",
          );
          item.setAttribute("data-category_id", String(entry.id));
          img.src = entry.image || img.dataset.fallback;
          img.alt = entry.name || "";
          label.textContent = entry.name || label.dataset.defaultLabel;
        };

        items.forEach((item) => {
          hydrateSlot(item, entryBySlot[item.getAttribute("data-slot")]);
        });
        const rotacion = gsap.to(isotipo, {
          rotation: "+=360",
          repeat: -1,
          ease: "linear",
          duration: 0.3,
          opacity: 0,
        });
        containerRuleta.classList.remove("opacity-0");
        btnGirar.disabled = true;
        ruletaIntroTween = gsap.to(ruletaTable, {
          rotation: "+=" + 360 * 50,
          duration: 1.5,
          ease: "power3.out",
          onComplete: () => {
            gsap.set(ruletaTable, { rotation: 0 });
            ruletaTable.removeAttribute("style");
            ruletaIntroTween = null;
            btnGirar.disabled = false;
            btnGirar.removeEventListener("click", girarRuleta);
            btnGirar.addEventListener("click", girarRuleta);
          },
        });

        gsap.from(isotipo, {
          scale: 600,
          transformOrigin: "50% 50%",
          duration: 1,
          opacity: 1,
          ease: "power3.out",
          onComplete: () => {
            rotacion.kill();
            gsap.set(isotipo, { rotation: 0 });
            isotipo.classList.remove("bg-logo-claro-gradient", "rounded-full");
            // The hub logo is part of the wheel art now: fade the zoom-in isotipo out.
            gsap.to(isotipo, { opacity: 0, duration: 0.3 });
            mainRuleta.classList.add("overflow-hidden");
            mainRuleta.classList.remove("h-full");
          },
        });
      } else {
        showCustomModal({
          title: "Lo sentimos, no puedes participar en estos momentos 👇",
          html: `<p>${reason}</p>`,
          iconSrc: icon_no_cumple.src,
          confirmButtonText: "Entendido",
          showCloseButton: false,
          onConfirm: () => {
            resetRuleta();
          },
        });
      }
    } catch (error) {
      console.error(error);
    } finally {
      togglePreloadAnimation(false);
    }
  });

  // Local-only test harness (window.ruletaDev). Vite strips this branch, and the
  // dynamic import, from production builds.
  if (import.meta.env.DEV) {
    import("@/utils/ruletaDev").then((m) =>
      m.install({
        deps,
        items,
        ruletaTable,
        targetAngle,
        girarRuleta,
        resetRuleta,
        resetSpinState: () => {
          yaGiro = false;
          btnGirar.disabled = false;
        },
      }),
    );
  }
</script>
